<?xml version="1.0" encoding="utf-8"?>
<!-- Покрытие считается только по бизнес-логике (слой Application всех модулей), как требует ТЗ: 80%+ по ветвям, 90%+ по операторам. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[SubscriptionManager.Api]SubscriptionManager.Modules.*.Application.*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
